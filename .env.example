# Single-account CLI only (npm run automate).
EMAIL=your-email@gmx.net
PASSWORD="your-password"

# Optional AnySolver CaptchaFox automation.
# Dashboard workers use this key with HTTP proxy uploads or Maskify API sessions.
# The CLI uses GMX_PROXY_URL below.
# The HTTP/HTTPS proxy must keep the same IP for Chrome and the solver.
ANYSOLVER_API_KEY=
GMX_PROXY_URL=
# Example format: http://username:password@proxy-host:8080

# Registration and IMAP/POP3 can use German sticky sessions from maskify.cjs.
MASKIFY_HOST=resi.maskify.su
MASKIFY_PORT=80
MASKIFY_USERNAME=
MASKIFY_PASSWORD=

# Registration uses HeroSMS for a German Ortel Mobile / Lycamobile GMX number and its SMS.
HEROSMS_API_KEY=

# Optional limits, in milliseconds.
SMS_MIN_REMAINING_MS=120000
SMS_PROVIDER_COOLDOWN_MS=60000
BROWSER_CLEANUP_TIMEOUT_MS=20000

# Local dashboard port (optional; default 3000).
PORT=3000
